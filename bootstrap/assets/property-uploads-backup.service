[Unit]
Description=Back up property application uploads to S3
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/property-app-deploy
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/property-app-deploy/backup-uploads.sh
UMask=0077
TimeoutStartSec=30min
